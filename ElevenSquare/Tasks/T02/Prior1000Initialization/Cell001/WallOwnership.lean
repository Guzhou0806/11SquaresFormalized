theorem full_hull_owned (q : UnitSquare)
    (hcell : ClosedCell 1 (normalizeCenter q.center))
    (hcont : ∀ p, ClosedSquare q p → InContainer coverCap p)
    (hchart : ∃ t : ℝ, 0 ≤ t ∧ t ≤ 1 ∧ q.axis = chartAxis t) :
    rationalHull archivedOwned ⊆ {p | OpenSquare q p} :=
  checked_wall_owned_hull 1 archivedOwned certificate certificate_checked q hcell hcont hchart

