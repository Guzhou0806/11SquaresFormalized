theorem ownership_checked (s : PoseState)
    (hr : s.rows (6 : Owner) = retainedRows) (ho : s.owned = ownedByRole) :
    ownershipCertificate.Check s (6 : Owner) := by
  refine ⟨?_, all_points_checked, ?_⟩
  · change checkedRows.map Prod.fst = s.rows (6 : Owner)
    rw [hr]
    rfl
  · change HullVerticesCheck (s.owned (6 : Owner) ++ freshVertices) nextOwned nextWitnesses
    rw [ho]
    exact retained_hull_checked

def nextState (s : PoseState) : PoseState :=
  replaceHull (replaceRows s (6 : Owner) retainedRows) (6 : Owner) nextOwned

def program : List IntegerRecordedInstruction :=
  [.rows (6 : Owner) records,
   .recorded (.basic (.trace (.ownership (6 : Owner) ownershipCertificate)))]

theorem program_checked (s : PoseState)
    (hr : s.rows (6 : Owner) = predecessorRows) (ho : s.owned = ownedByRole) :
    IntegerRecordedProgramCheck s program := by
  refine ⟨⟨hr.symm, records_checked s ho⟩, ?_, trivial⟩
  change ownershipCertificate.Check (replaceRows s (6 : Owner) (integerRowsOutput records)) (6 : Owner)
  apply ownership_checked
  · simp only [replaceRows, Function.update_self, output_matches]
  · exact ho

theorem program_output (s : PoseState) : integerRecordedProgramRun s program = nextState s := by
  simp only [integerRecordedProgramRun, program, IntegerRecordedInstruction.run,
    RecordedInstruction.run, StateInstruction.run, FiniteInstruction.run, output_matches]
  rfl

/-- This entire archived step is proved conditional on the exact predecessor
rows and owned hulls. Reachability from an actual root is a separate theorem. -/
theorem step_holds {S : ℝ} (P : Packing 11 S) (s : PoseState) (hs : StateHolds P s)
    (hr : s.rows (6 : Owner) = predecessorRows) (ho : s.owned = ownedByRole) :
    StateHolds P (nextState s) := by
  have h := integer_recorded_program_sound P s program (program_checked s hr ho) hs
  simpa only [program_output] using h

end
