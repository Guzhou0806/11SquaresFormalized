/-- Desired owned lists; each listed vertex needs a checked full-chart certificate. -/
def ownedRoster (c : Fin 16) : List QPoint :=
  if c.val = 1 then ownedRosterCell01 else
  if c.val = 2 then ownedRosterCell02 else
  if c.val = 4 then ownedRosterCell04 else
  if c.val = 5 then ownedRosterCell05 else
  if c.val = 8 then ownedRosterCell08 else
  if c.val = 11 then ownedRosterCell11 else
  if c.val = 14 then ownedRosterCell14 else
  []

/-- All chosen roster points lie in their cell square throughout the closed chart. -/
def OwnedRosterFullChart : Prop :=
  ∀ (cell : Fin 16) (q : UnitSquare),
    ClosedCell cell (normalizeCenter q.center) →
    (∀ p, ClosedSquare q p → InContainer coverCap p) →
    (∃ t : ℝ, 0 ≤ t ∧ t ≤ 1 ∧ q.axis = chartAxis t) →
    ∀ v ∈ ownedRoster cell, OpenSquare q (realPoint v)

/-- A blocked point is referenced by its position in the shared cell roster. -/
def rosterBlock (partner : Fin 16 → Owner) (cell : Fin 16) (index : ℕ) : OwnedBlock where
  point := (ownedRoster cell).getD index (0, 0)
  partner := partner cell
  witness := .vertex index

theorem roster_block_check (s : PoseState) (partner : Fin 16 → Owner)
    (ownerCell blockCell : Fin 16) (index : ℕ)
    (hne : partner ownerCell ≠ partner blockCell)
    (howned : s.owned (partner blockCell) = ownedRoster blockCell)
    (hi : index < (ownedRoster blockCell).length) :
    (rosterBlock partner blockCell index).Check s (partner ownerCell) := by
  refine ⟨hne, ?_, ?_⟩
  · simpa [rosterBlock, HullWitness.Valid, howned] using hi
  · simp [rosterBlock, HullWitness.eval, howned]

end
