def residualBounds (b : Fin 128) (j : Fin 33) (s : Fin 2) : ℚ :=
  (residualNumerators b j s : ℚ) / 1000000000000000000000000

def proposedPacket : LocalPacket where
  radii := focusedRadii
  maxRadius := proposedMaxRadius
  representative b i := representatives (branchRows b i)
  aliases b i := rowAliases (branchRows b i)
  curvature b i := rowCurvatures (branchRows b i)
  dual b j s i := (dualNumerators b j s i : ℚ) / 1000000000000
  residual := residualBounds

theorem proposedPacket_radii : proposedPacket.radii = focusedRadii := rfl

theorem proposedPacket_representative_mem (b : Fin 128) (i : Fin 42) :
    proposedPacket.representative b i ∈ proposedPacket.aliases b i :=
  representative_mem_aliases (branchRows b i)

theorem proposedPacket_dual_nonneg (b : Fin 128) (j : Fin 33) (s : Fin 2) (i : Fin 42) :
    0 ≤ proposedPacket.dual b j s i := by
  dsimp [proposedPacket]
  positivity

